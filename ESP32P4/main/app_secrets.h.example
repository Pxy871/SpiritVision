#pragma once

/*
 * 敏感配置模板。
 *
 * 使用方法：复制本文件为 main/app_secrets.h，填入真实值。
 * app_secrets.h 已加入 .gitignore，严禁把真实凭据提交到 git。
 */

/* WiFi 接入点（2.4GHz，编译期写死，不做配网） */
#define APP_WIFI_SSID "your-wifi-ssid"
#define APP_WIFI_PASSWORD "your-wifi-password"

/* EMQX Cloud Serverless，MQTT over TLS（8883） */
#define APP_MQTT_URI "mqtts://your-deployment.ala.cn-hangzhou.emqxsl.cn:8883"

/* EMQX 控制台「访问控制 -> 认证」中创建的用户名/密码（不是 API Key） */
#define APP_MQTT_USERNAME "your-mqtt-username"
#define APP_MQTT_PASSWORD "your-mqtt-password"
